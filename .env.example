# ============================================================
# FPV Sales Bot — пример файла переменных окружения.
# Скопируйте в .env и заполните реальными значениями.
# ============================================================

# --- Telegram ---
BOT_TOKEN=123456789:AAAAExampleTokenHere
ADMIN_ID=123456789

# --- AI-провайдер ---
# Какой бэкенд использует бот (services/ai_providers):
#   cloudflare — Cloudflare AI Worker (fpv-ai-proxy), по умолчанию
#   yandex     — YandexGPT + Yandex SpeechKit
AI_PROVIDER=cloudflare

# --- Cloudflare AI Worker (при AI_PROVIDER=cloudflare) ---
AI_PROXY_URL=https://fpv-ai-proxy.example.workers.dev
AI_PROXY_TOKEN=secret-token

# Собственные переменные прокси fpv-ai-proxy (ботом не читаются):
# AI_MODE=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_AI_MODEL=

# --- YandexGPT (при AI_PROVIDER=yandex) ---
# API-ключ Yandex Cloud (сервисный аккаунт) для YandexGPT и SpeechKit.
YANDEX_API_KEY=
# Идентификатор каталога (folder id), в котором доступна модель.
YANDEX_FOLDER_ID=
# Необязательно: IAM-токен вместо YANDEX_API_KEY (Bearer-авторизация).
# YANDEX_IAM_TOKEN=
# Модель генерации: yandexgpt (по умолчанию) | yandexgpt-lite | yandexgpt-32k
# YANDEX_MODEL=yandexgpt
#
# Системный промт ассистента (коуч-продажник: АКБ и дроны) задаётся в коде:
# services/ai_providers/prompts.py

# --- База данных (пакет db) ---
# SQLAlchemy URL. По умолчанию (пусто) — SQLite: файл data/bot.db.
# Прод-совет: вынести БД из папки кода — тогда unzip -o нового релиза её
# не перезапишет (каталог бот создаст сам; у пользователя сервиса должна
# быть запись в этот каталог):
# DB_URL=sqlite:////root/fpvbot_data/bot.db
# Для PostgreSQL: раскомментировать, установить asyncpg (см. requirements.txt)
# и указать свои параметры подключения:
# DB_URL=postgresql+asyncpg://fpv:password@localhost:5432/fpv_bot

# --- Сетевой прокси для Telegram API (опционально) ---
# Пусто = без прокси (по умолчанию). На VPS оставляйте ПУСТЫМ — сервер ходит
# в Telegram напрямую; прокси нужен только на локальной машине за блокировкой.
PROXY_URL=
# SOCKS5 (рекомендуется; поддержка через aiohttp-socks):
# PROXY_URL=socks5://user:password@host:1080
# PROXY_URL=socks5://host:1080
# HTTP-прокси:
# PROXY_URL=http://user:password@host:8080

# --- Watchdog (deploy/watchdog.py; установка — раздел 5 deploy/README.md) ---
# Файл пульса: bot.py пишет метку времени раз в HEARTBEAT_INTERVAL секунд,
# серверный watchdog (таймер раз в 4 ч) проверяет свежесть и перезапускает
# сервис при зависании. Пусто — проверка выключена (на dev-машине так и надо).
HEARTBEAT_FILE=
# Необязательно: порог «просрочки» метки у watchdog, с (по умолчанию 900)
# HEARTBEAT_MAX_AGE=900
# Необязательно: период записи метки, с (по умолчанию 60)
# HEARTBEAT_INTERVAL=60
